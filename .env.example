# =======================================================
# The Five Agents - Environment Variables (example)
# =======================================================
# Copy this file to `.env` and fill in real values.
# Never commit `.env` itself (it's listed in .gitignore).

# --- General ---
# Anthropic API key, used by any custom skill/code that
# calls the Claude API directly.
ANTHROPIC_API_KEY=

# --- Optional: per-agent integrations ---
# These are placeholders for future use - uncomment and
# fill in once we actually wire up the relevant tools.

# Yuval (designer) - image generation provider
# IMAGE_API_KEY=

# Chen (researcher) - web search / research provider
# SEARCH_API_KEY=
